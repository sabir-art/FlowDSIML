    "@flowdsiml/supabase-types": "workspace:*",
    "@flowdsiml/ui": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "^0.8.3",
    "i18next": "^25.10.10",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
