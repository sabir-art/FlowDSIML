    "a11y": "node e2e/a11y.e2e.cjs"
  },
  "dependencies": {
    "@flowdsiml/core": "workspace:*",
    "@flowdsiml/exports": "workspace:*",
    "@flowdsiml/manifest": "workspace:*",
