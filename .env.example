# Copier en apps/web/.env.local et apps/player/.env.local (jamais commité).
# Valeurs publiques par conception (la sécurité repose sur RLS).
# Obligatoires au build (aucune valeur par défaut dans le code). Pour le build de production en local :
# apps/web/.env.production.local et apps/player/.env.production.local (jamais commités).
VITE_SUPABASE_URL=https://<projet>.supabase.co
VITE_SUPABASE_ANON_KEY=
# URL publique du player (pour générer liens et snippets d'embed)
VITE_PLAYER_URL=http://localhost:5174
# Page de l'extension dans la boutique du navigateur (modale « Extension »). Vide = lien masqué.
# Le support de la DSI se règle par espace (Paramètres > Espace > Général, « Lien du support »).
VITE_EXTENSION_URL=
# Adresse publique de l'app pour la télécommande du mode présentateur (QR code). Vide = adresse courante.
VITE_REMOTE_ORIGIN=
