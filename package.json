{
  "name": "flowdsiml",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "pnpm check:workflows && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:test:local": "bash supabase/tests/local/run.sh",
    "check:rpc": "node scripts/check-rpc-signatures.mjs",
    "db:types": "supabase gen types typescript --project-id \"${SUPABASE_PROJECT_REF:?variable SUPABASE_PROJECT_REF manquante}\" --schema public > packages/supabase-types/src/database.ts",
    "db:types:local": "supabase gen types typescript --local --schema public > packages/supabase-types/src/database.ts",
    "check:workflows": "node scripts/check-workflows.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "js-yaml": "4.3.2",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "tldts>tldts-core": "7.4.19"
    }
  }
}
